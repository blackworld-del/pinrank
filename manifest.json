{
  "manifest_version": 3,
  "name": "PinRank — Pinterest SEO overlay",
  "version": "0.1.0",
  "description": "Shows saves, comments and SEO detail on every pin you browse on Pinterest.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://*.pinterest.com/*"],
      "js": ["src/extract.js", "src/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.pinterest.com/*"],
      "js": ["src/extract.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://*.pinterest.com/*"]
}
