{
  "manifest_version": 3,
  "name": "PinRank — Pinterest SEO overlay",
  "version": "0.2.0",
  "description": "Shows position, saves, comments and pin age on every pin you browse on Pinterest.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PinRank — Pinterest SEO overlay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.pinterest.com/*"],
      "js": ["src/extract.js", "src/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.pinterest.com/*"],
      "js": ["src/extract.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://*.pinterest.com/*"]
}
